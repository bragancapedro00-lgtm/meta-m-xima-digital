# ==============================================================================
# VARIÁVEIS DE AMBIENTE - META MÁXIMA DIGITAL (CONTENT CRM)
# ==============================================================================

# Google Gemini AI (Interactions API)
GEMINI_API_KEY=sua-chave-gemini-api-aqui
GEMINI_MODEL=gemini-3.6-flash
GOOGLE_CLOUD_PROJECT=projects/seu-projeto-id
GOOGLE_PROJECT_NUMBER=seu-numero-do-projeto

# Supabase (Banco de Dados PostgreSQL, Auth e Storage)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-chave-secreta-service-role-aqui

# Meta Graph API (Instagram & Facebook Insights)
META_APP_ID=seu-meta-app-id
META_APP_SECRET=seu-meta-app-secret
META_REDIRECT_URI=http://localhost:3000/api/auth/meta/callback

# Google Analytics 4 (GA4 Data API)
GA4_PROPERTY_ID=properties/123456789
GOOGLE_CLIENT_ID=seu-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
